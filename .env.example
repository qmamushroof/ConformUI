# Copy to .env.local (git-ignored). All VITE_* values are public config (SPEC-DEPLOY-02).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Dev only (SPEC-FB-04)
VITE_APPCHECK_DEBUG=
VITE_APPCHECK_DEBUG_TOKEN=
# E2E build only (set by --mode e2e)
VITE_E2E=
# Injected at build: version and repository URL from package.json, short commit from git
VITE_APP_VERSION=
VITE_APP_COMMIT=
VITE_REPO_URL=
