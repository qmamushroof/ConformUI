{
  "$description": "ConformUI tokens, direction Caliper (calmed). Four hues only: blue = action/focus/design region, red = Fail, green = Pass, magenta = diff overlay only. Severity is shape + word in ink, never hue. Neutrals tinted toward the blue (h 260).",
  "color": {
    "$type": "color",
    "primitive": {
      "neutral": {
        "0":   { "$value": "#FFFFFF" },
        "50":  { "$value": "oklch(98.5% 0.003 260)" },
        "100": { "$value": "oklch(96.6% 0.005 260)" },
        "200": { "$value": "oklch(91.8% 0.008 260)" },
        "300": { "$value": "oklch(85.5% 0.010 260)" },
        "400": { "$value": "oklch(71% 0.014 260)" },
        "500": { "$value": "oklch(54% 0.016 260)" },
        "600": { "$value": "oklch(45% 0.018 260)" },
        "700": { "$value": "oklch(37% 0.018 260)" },
        "800": { "$value": "oklch(28.5% 0.015 260)" },
        "850": { "$value": "oklch(23.5% 0.013 260)" },
        "900": { "$value": "oklch(19.5% 0.011 260)" },
        "950": { "$value": "oklch(15.5% 0.009 260)" },
        "1000": { "$value": "oklch(12.5% 0.008 260)" }
      },
      "blue":  { "50": { "$value": "#EFF4FF" }, "300": { "$value": "#93C5FD" }, "400": { "$value": "#60A5FA" }, "600": { "$value": "#2563EB" }, "700": { "$value": "#1D4ED8" }, "950": { "$value": "#16223A" } },
      "red":   { "300": { "$value": "#FF8A80" }, "700": { "$value": "#B42318" } },
      "green": { "300": { "$value": "#6FE39A" }, "700": { "$value": "#0F7A3A" } },
      "magenta": { "500": { "$value": "#FF00FF" } }
    },
    "light": {
      "bg": { "$value": "{color.primitive.neutral.0}" },
      "surface": { "$value": "{color.primitive.neutral.50}" },
      "surface-raised": { "$value": "{color.primitive.neutral.0}" },
      "surface-sunken": { "$value": "{color.primitive.neutral.100}" },
      "border": { "$value": "{color.primitive.neutral.200}" },
      "border-strong": { "$value": "{color.primitive.neutral.500}" },
      "text": { "$value": "{color.primitive.neutral.950}" },
      "text-muted": { "$value": "{color.primitive.neutral.600}" },
      "text-subtle": { "$value": "{color.primitive.neutral.500}" },
      "accent": { "$value": "{color.primitive.blue.600}" },
      "accent-hover": { "$value": "{color.primitive.blue.700}" },
      "accent-fg": { "$value": "{color.primitive.neutral.0}" },
      "accent-subtle": { "$value": "{color.primitive.blue.50}" },
      "focus": { "$value": "{color.primitive.blue.600}" },
      "danger": { "$value": "{color.primitive.red.700}" },
      "danger-fg": { "$value": "{color.primitive.neutral.0}" },
      "success": { "$value": "{color.primitive.green.700}" },
      "success-fg": { "$value": "{color.primitive.neutral.0}" },
      "diff": { "$value": "{color.primitive.magenta.500}" }
    },
    "dark": {
      "bg": { "$value": "{color.primitive.neutral.950}" },
      "surface": { "$value": "{color.primitive.neutral.900}" },
      "surface-raised": { "$value": "{color.primitive.neutral.850}" },
      "surface-sunken": { "$value": "{color.primitive.neutral.1000}" },
      "border": { "$value": "{color.primitive.neutral.800}" },
      "border-strong": { "$value": "{color.primitive.neutral.500}" },
      "text": { "$value": "{color.primitive.neutral.50}" },
      "text-muted": { "$value": "{color.primitive.neutral.400}" },
      "text-subtle": { "$value": "{color.primitive.neutral.400}" },
      "accent": { "$value": "{color.primitive.blue.400}" },
      "accent-hover": { "$value": "{color.primitive.blue.300}" },
      "accent-fg": { "$value": "{color.primitive.neutral.950}" },
      "accent-subtle": { "$value": "{color.primitive.blue.950}" },
      "focus": { "$value": "{color.primitive.blue.400}" },
      "danger": { "$value": "{color.primitive.red.300}" },
      "danger-fg": { "$value": "{color.primitive.neutral.950}" },
      "success": { "$value": "{color.primitive.green.300}" },
      "success-fg": { "$value": "{color.primitive.neutral.950}" },
      "diff": { "$value": "{color.primitive.magenta.500}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": { "$value": ["IBM Plex Sans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "Cascadia Mono", "Menlo", "Consolas", "monospace"] }
  },
  "font-size": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" }, "sm": { "$value": "0.875rem" }, "md": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.25rem" }, "2xl": { "$value": "1.5rem" }, "3xl": { "$value": "1.75rem" }
  },
  "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } },
  "leading": { "$type": "number", "tight": { "$value": 1.2 }, "snug": { "$value": 1.35 }, "normal": { "$value": 1.5 } },
  "tracking": { "$type": "dimension", "tight": { "$value": "-0.015em" }, "normal": { "$value": "0" } },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0" }, "0-5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" },
    "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }
  },
  "radius": { "$type": "dimension", "sm": { "$value": "3px" }, "md": { "$value": "4px" }, "lg": { "$value": "6px" } },
  "border": { "$type": "dimension", "thin": { "$value": "1px" }, "thick": { "$value": "2px" } },
  "elevation": {
    "$type": "shadow",
    "light": {
      "sheet": { "$value": "0 1px 2px oklch(20% 0.01 260 / 0.06), 0 16px 40px -8px oklch(20% 0.01 260 / 0.20)" },
      "menu": { "$value": "0 1px 2px oklch(20% 0.01 260 / 0.06), 0 6px 16px -4px oklch(20% 0.01 260 / 0.14)" }
    },
    "dark": {
      "sheet": { "$value": "0 0 0 1px oklch(100% 0 0 / 0.08), 0 20px 48px oklch(0% 0 0 / 0.55)" },
      "menu": { "$value": "0 0 0 1px oklch(100% 0 0 / 0.08), 0 8px 20px oklch(0% 0 0 / 0.45)" }
    }
  },
  "duration": { "$type": "duration", "fast": { "$value": "100ms" }, "base": { "$value": "150ms" }, "slow": { "$value": "200ms" } },
  "ease": { "$type": "cubicBezier", "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }, "enter": { "$value": "cubic-bezier(0, 0, 0, 1)" }, "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" } },
  "z": { "$type": "number", "sticky": { "$value": 200 }, "menu": { "$value": 300 }, "sheet": { "$value": 400 }, "toast": { "$value": 500 } },
  "breakpoint": { "$type": "dimension", "sm": { "$value": "640px" }, "md": { "$value": "900px" }, "lg": { "$value": "1100px" }, "xl": { "$value": "1440px" } },
  "layout": { "$type": "dimension", "content": { "$value": "1120px" }, "prose": { "$value": "68ch" }, "list": { "$value": "380px" }, "header": { "$value": "56px" }, "target": { "$value": "44px" } },
  "$pairs": [["accent", "surface"], ["accent", "accent-subtle"], ["text", "accent-subtle"], ["danger", "surface"], ["success", "surface"], ["danger", "surface-raised"], ["text-muted", "accent-subtle"], ["border-strong", "surface", 3]]
}
